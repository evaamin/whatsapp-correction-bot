# =============================================================================
# WhatsApp Correction & Follow-up Bot — configuration
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# is loaded automatically at startup (see app/config.py). Nothing in this
# repo reads credentials from anywhere else, so this file is the single
# place secrets live.
#
#   cp .env.example .env
# =============================================================================

# --- WhatsApp provider ---------------------------------------------------------
# Which outbound API app/messaging.py uses: "twilio" or "meta" (Meta's
# WhatsApp Cloud API, called directly — no Twilio involved). Only the
# section below matching your choice needs to be filled in.
WHATSAPP_PROVIDER=twilio

# --- Twilio (WhatsApp via Twilio's sandbox or a Twilio-hosted number) ---------
# Found on the Twilio Console dashboard (https://console.twilio.com).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# The WhatsApp-enabled Twilio number that sends/receives all bot messages.
# Must be in Twilio's "whatsapp:+1..." format.
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Only needed if you provision a separate WhatsApp Business API token
# (distinct from the account auth token above) — e.g. for the Twilio API Keys
# flow instead of the main auth token. Leave blank if not applicable.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# --- Meta WhatsApp Cloud API (direct, no Twilio) --------------------------------
# From your Meta App Dashboard -> WhatsApp -> API Setup.
# A temporary token lasts 24h; generate a permanent one via a System User
# for anything longer-lived than manual testing.
WHATSAPP_ACCESS_TOKEN=your_meta_access_token_here

# The "Phone number ID" shown in API Setup (NOT the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Any string you make up. Enter the same value in the Meta App Dashboard's
# webhook configuration screen — Meta echoes it back on the GET verification
# request to /webhook/whatsapp/meta to prove you control that URL.
WHATSAPP_VERIFY_TOKEN=choose_a_random_verify_token

# --- Claude API (reply classification: acknowledgement vs substantive) --------
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model used to classify center replies. Defaults to Opus; swap to a cheaper/
# faster model (e.g. claude-haiku-4-5) if you want to cut classification
# cost — this is a one-line change and won't affect anything else.
ANTHROPIC_MODEL=claude-opus-5

# --- Coordinator identity ------------------------------------------------------
# The WhatsApp number the coordinator sends correction requests from.
# Format: "whatsapp:+1..." — messages from any other number are treated as
# a center reply (or ignored if no center matches), never as a new request.
COORDINATOR_WHATSAPP_NUMBER=whatsapp:+15550000000

# --- Follow-up scheduler --------------------------------------------------------
# How long a center can stay silent before the bot sends an automatic nudge.
FOLLOWUP_INTERVAL_MINUTES=1440

# How many nudges to send before giving up and marking the request "overdue".
MAX_FOLLOWUPS=3

# How often the background scheduler checks for requests that need a nudge.
FOLLOWUP_CHECK_INTERVAL_SECONDS=300

# --- Storage ---------------------------------------------------------------------
# SQLite file holding the tracking log. Relative paths are resolved from the
# project root. See README for how to inspect/export this.
DB_PATH=data/tracking.db

# Maps center names to their WhatsApp numbers. See centers.example.json.
CENTERS_FILE=centers.json
